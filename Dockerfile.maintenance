# ──────────────────────────────────────────────────────────────
# NeverBrokeAgain — Maintenance & Error fallback (Nginx)
# Sert deux pages premium standalone (inline CSS/JS only) :
#   • /index.html      → maintenance programmée (deploy, prio 999)
#   • /502.html etc.   → fallback Traefik 5xx (crash sans maintenance)
# ──────────────────────────────────────────────────────────────
FROM nginx:alpine

# Pages — copiées telles quelles, aucune dépendance externe requise.
COPY scripts/maintenance.html /usr/share/nginx/html/index.html
COPY scripts/502.html         /usr/share/nginx/html/502.html
# Duplique pour les autres codes Traefik (500-599). Le middleware query="/{status}.html"
# demandera /502.html, /503.html, etc. On alias donc 503/500/504 vers le même fichier.
RUN cp /usr/share/nginx/html/502.html /usr/share/nginx/html/503.html \
 && cp /usr/share/nginx/html/502.html /usr/share/nginx/html/500.html \
 && cp /usr/share/nginx/html/502.html /usr/share/nginx/html/504.html

# Nginx — cache désactivé, fallback propre.
RUN printf '%s\n' \
  'server {' \
  '    listen 80;' \
  '    root /usr/share/nginx/html;' \
  '    add_header Cache-Control "no-cache, no-store, must-revalidate" always;' \
  '    add_header Pragma "no-cache" always;' \
  '    add_header Expires "0" always;' \
  '    add_header X-Content-Type-Options "nosniff" always;' \
  '    add_header X-Frame-Options "DENY" always;' \
  '    location ~ ^/(502|503|500|504)\.html$ { try_files $uri =404; }' \
  '    location = / { try_files /index.html =404; }' \
  '    location / { try_files $uri $uri.html /index.html; }' \
  '    location /api/ { return 503; }' \
  '}' > /etc/nginx/conf.d/default.conf

# ──────────────────────────────────────────────────────────────
# Comment câbler le fallback 502/503 dans Traefik (compose.yml)
# ──────────────────────────────────────────────────────────────
# Le service `maintenance` existe déjà (priority 999). Pour que Traefik
# affiche une belle page au lieu du brut "502 Bad Gateway" quand `app`
# crash *sans* que le conteneur maintenance soit levé, ajouter un
# middleware `errors` qui rejoue la requête vers ce même service :
#
# services:
#   maintenance:
#     # ... labels existants ...
#     labels:
#       - "traefik.enable=true"
#       - "traefik.http.routers.nba-maintenance.rule=Host(`access.signauxx.com`)"
#       - "traefik.http.routers.nba-maintenance.priority=999"
#       - "traefik.http.routers.nba-maintenance.entrypoints=websecure"
#       - "traefik.http.routers.nba-maintenance.tls=true"
#       - "traefik.http.routers.nba-maintenance.tls.certresolver=letsencrypt"
#       - "traefik.http.services.nba-maintenance.loadbalancer.server.port=80"
#       # ── Nouveau : middleware erreurs 5xx ──
#       - "traefik.http.middlewares.nba-errors.errors.status=500-599"
#       - "traefik.http.middlewares.nba-errors.errors.service=nba-maintenance"
#       - "traefik.http.middlewares.nba-errors.errors.query=/{status}.html"
#   app:
#     labels:
#       # ... existants ...
#       - "traefik.http.routers.nba-app.middlewares=nba-errors"
#
# Effet : si `nba-app` renvoie 502/503/500, Traefik intercepte et refait
# une requête interne GET /502.html (ou /503.html) vers `nba-maintenance`,
# qui sert alors `scripts/502.html` — design premium cohérent avec
# `scripts/maintenance.html`. Aucun changement côté Nginx.
# Alternative : attacher le middleware au niveau entrypoint si Traefik
# est géré hors compose.
# ──────────────────────────────────────────────────────────────
