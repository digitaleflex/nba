# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/nba_dev?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# WebSocket (Socket.IO) pour notifications temps réel, signaux live, etc.
# WS_ENABLED=true lance le serveur WebSocket dans le conteneur via PM2 (port 3001)
WS_ENABLED=true
WS_PORT=3001

# Better Auth
BETTER_AUTH_SECRET=your-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Web Push (VAPID) - généré via `npx web-push generate-vapid-keys`
# Requis pour les notifications push (messages, signaux, etc.)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@signauxx.com

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@signauxx.com
# Resend webhook signing secret (from Resend dashboard → Webhooks). Keep secret.
RESEND_WEBHOOK_SECRET=

# Emails
SUPPORT_EMAIL=support@signauxx.com
ADMIN_EMAIL=admin@signauxx.com
CONTACT_EMAIL=contact@signauxx.com
TEAM_EMAIL=team@signauxx.com

# Cloudflare (optional for local)
CLOUDFLARE_API_TOKEN=

# Telegram Bot API (optional)
# Mettre à false pour désactiver totalement l'envoi Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# WhatsApp Business API (optional, payant au-delà de 1000 conversations/mois)
# Mettre à false pour désactiver totalement l'envoi WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Admin auto-creation (Docker entrypoint)
# Set these to auto-create a SUPER_ADMIN on first run
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# MinIO & imgproxy (S3-compatible Self-hosted Storage & Image Optimization)
# ATTENTION: ne jamais réutiliser ces valeurs en production.
# Générer就地: openssl rand -hex 16 (MINIO_ROOT_PASSWORD, IMGPROXY_KEY, IMGPROXY_SALT)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD_32chars_min
IMGPROXY_KEY=CHANGE_ME_imgproxy_key_32_hex_chars_min
IMGPROXY_SALT=CHANGE_ME_imgproxy_salt_32_hex_chars_min
