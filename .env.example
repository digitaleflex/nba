# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/nba_dev?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=your-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Web Push (VAPID) - généré via `npx web-push generate-vapid-keys`
# Requis pour les notifications push (messages, signaux, etc.)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@signauxx.com

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@signauxx.com

# Emails
SUPPORT_EMAIL=support@signauxx.com
ADMIN_EMAIL=admin@signauxx.com
CONTACT_EMAIL=contact@signauxx.com
TEAM_EMAIL=team@signauxx.com

# Cloudflare (optional for local)
CLOUDFLARE_API_TOKEN=

# Admin auto-creation (Docker entrypoint)
# Set these to auto-create a SUPER_ADMIN on first run
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# MinIO & imgproxy (S3-compatible Self-hosted Storage & Image Optimization)
MINIO_ROOT_USER=nba_admin
MINIO_ROOT_PASSWORD=Z3k_mQ7x-P2wT-9yRb-8vFd-5sHg_4aJp
IMGPROXY_KEY=51b3bb889f81216d2eb15a770d10b7db
IMGPROXY_SALT=3b20bd40e0bc4ad21a7114620f4c3489
