generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

// ── Better Auth Core Models ──

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // NBA custom fields
  phone             String?
  whatsapp          String?           @map("whatsapp")
  roleId            String            @map("role_id") @db.Uuid
  country           String?
  language          String            @default("fr")
  timezone          String            @default("Europe/Paris") @map("timezone")
  onboardingStatus  OnboardingStatus  @default(REGISTERED) @map("onboarding_status")
  isActive          Boolean           @default(true) @map("is_active")
  suspendedAt       DateTime?         @map("suspended_at")
  signalsAccessOverride Boolean       @default(false) @map("signals_access_override")
  metadata          Json?             @db.JsonB
  deletedAt         DateTime?         @map("deleted_at")
  notificationSound String           @default("default") @map("notification_sound")
  emailStatus       EmailStatus       @default(OK) @map("email_status")
  emailStatusAt     DateTime?         @map("email_status_at")

  sessions            Session[]
  accounts            Account[]
  role                Role                  @relation(fields: [roleId], references: [id])
  accessRequests      AccessRequest[]
  kycDocuments        KycDocument[]         @relation("KycDocuments")
  kycReviews          KycDocument[]         @relation("KycReviews")
  accessReviews       AccessRequest[]       @relation("AccessReviews")
  brokerVerifications BrokerVerification[]  @relation("BrokerVerifications")
  brokerReviews       BrokerVerification[]  @relation("BrokerReviews")
  signals             Signal[]
  signalVersions      SignalVersion[]
  signalReads         SignalRead[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  auditLogs           AuditLog[]
  settings            Setting[]
  devices             Device[]
  deviceVerifications DeviceVerification[]
  signalFavorites     SignalFavorite[]
  signalArchives      SignalArchive[]
  trades              Trade[]
  dailyReflections    DailyReflection[]
  journalSessions     JournalSession[]
  streaks             Streak[]
  conversations       ConversationParticipant[]
  messages            Message[]           @relation("SentMessages")
  reactions           MessageReaction[]
  reports             MessageReport[]
  securityEvents      SecurityEvent[]
  loginAttempts       LoginAttempt[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  securityPolicy      SecurityPolicy?

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

// ── Messaging (Admin <-> Member, type Messenger) ──

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @default("DIRECT")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  type           String    @default("TEXT") @map("type")
  content        String
  attachmentUrl  String?   @map("attachment_url")
  attachmentMime String?   @map("attachment_mime")
  attachmentName String?   @map("attachment_name")
  attachmentSize Int?      @map("attachment_size")
  readAt         DateTime? @map("read_at")
  editedAt       DateTime? @map("edited_at")
  deletedAt      DateTime? @map("deleted_at")
  quotedMessageId String?  @map("quoted_message_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  quotedMessage Message?     @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy      Message[]    @relation("MessageQuote")
  reactions     MessageReaction[]
  reports       MessageReport[]

  @@index([conversationId])
  @@index([senderId])
  @@index([deletedAt])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageReport {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reason     String
  handledAt  DateTime? @map("handled_at")
  createdAt  DateTime @default(now()) @map("created_at")

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([handledAt])
  @@map("message_reports")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── NEW SECURITY FIELDS ──
  deviceId      String?  @map("device_id") @db.Uuid
  riskScore     Int      @default(0) @map("risk_score")
  riskLevel     String   @default("LOW") @map("risk_level")
  country       String?  @map("country")
  city          String?  @map("city")
  latitude      Float?   @map("latitude")
  longitude     Float?   @map("longitude")
  isHighRisk    Boolean  @default(false) @map("is_high_risk")
  riskReason    String?  @map("risk_reason")
  fingerprint   String?  @map("fingerprint")
  lastRotation  DateTime? @map("last_rotation")

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([deviceId])
  @@index([riskLevel])
  @@map("sessions")
}

model Account {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  accountId               String    @map("account_id")
  providerId              String    @map("provider_id")
  accessToken             String?   @map("access_token")
  refreshToken            String?   @map("refresh_token")
  accessTokenExpiresAt    DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt   DateTime? @map("refresh_token_expires_at")
  scope                   String?
  idToken                 String?   @map("id_token")
  password                String?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// ── NBA Business Models ──

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  currency     String
  durationDays Int      @map("duration_days")
  features     Json     @default("[]") @db.JsonB
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // ── NEW SECURITY FIELDS ──
  maxSessions Int @default(5) @map("max_sessions")
  maxDevices  Int @default(3) @map("max_devices")
  require2fa  Boolean @default(false) @map("require_2fa")

  accessRequests AccessRequest[]
  audience       SignalAudience[]
  sessions       JournalSession[]

  @@map("subscription_plans")
}

model AccessRequest {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  planId        String       @map("plan_id") @db.Uuid
  status        AccessStatus @default(PENDING)
  reviewedBy    String?      @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?    @map("reviewed_at")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewer User?            @relation("AccessReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([userId, planId, status]) // Composite for access check
  @@index([status, createdAt])
  @@map("access_requests")
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String?
  fingerprint  String   @map("fingerprint")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  deviceType   String?  @map("device_type")
  brand        String?  @map("brand")
  model        String?  @map("model")
  os           String?  @map("os")
  browser      String?  @map("browser")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  trusted      Boolean  @default(true) @map("trusted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ── NEW SECURITY FIELDS ──
  trustLevel    DeviceTrustLevel @default(UNKNOWN) @map("trust_level")
  riskScore     Int              @default(0) @map("risk_score")
  is2faBypassed Boolean          @default(false) @map("is_2fa_bypassed")
  firstSeenAt   DateTime         @map("first_seen_at")
  trustedUntil  DateTime?        @map("trusted_until")
  lastCountry   String?          @map("last_country")

  flagVpn       Boolean @default(false) @map("flag_vpn")
  flagProxy     Boolean @default(false) @map("flag_proxy")
  flagTor       Boolean @default(false) @map("flag_tor")
  flagDatacenter Boolean @default(false) @map("flag_datacenter")

  sessions       Session[]
  securityEvents SecurityEvent[]
  loginAttempts  LoginAttempt[]
  user           User           @relation(fields: [userId], references: [id])

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([fingerprint])
  @@index([trustLevel])
  @@index([trusted])
  @@map("devices")
}

model DeviceVerification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  deviceFingerprint String    @map("device_fingerprint")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  deviceType        String?   @map("device_type")
  brand             String?   @map("brand")
  model             String?   @map("model")
  os                String?   @map("os")
  browser           String?   @map("browser")
  verificationCode  String    @map("verification_code")
  expiresAt         DateTime  @map("expires_at")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("device_verifications")
}

model KycDocument {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  documentType   DocumentType       @map("document_type")
  status         VerificationStatus @default(PENDING)
  frontFilePath  String             @map("front_file_path")
  backFilePath   String?            @map("back_file_path")
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  reviewNotes    String?            @map("review_notes")
  reviewedAt     DateTime?          @map("reviewed_at")
  submittedAt    DateTime           @default(now()) @map("submitted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user     User  @relation("KycDocuments", fields: [userId], references: [id])
  reviewer User? @relation("KycReviews", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@map("kyc_documents")
}

model BrokerVerification {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  brokerName    String             @map("broker_name")
  accountId     String             @map("account_id")
  videoFilePath String             @map("video_file_path")
  status        VerificationStatus @default(PENDING)
  reviewedBy    String?            @map("reviewed_by") @db.Uuid
  reviewNotes   String?            @map("review_notes")
  reviewedAt    DateTime?          @map("reviewed_at")
  submittedAt   DateTime           @default(now()) @map("submitted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user     User  @relation("BrokerVerifications", fields: [userId], references: [id])
  reviewer User? @relation("BrokerReviews", fields: [reviewedBy], references: [id])

  @@index([status])
  @@map("broker_verifications")
}

model Signal {
  id                  String       @id @default(uuid()) @db.Uuid
  content             String
  imageUrl            String?      @map("image_url")
  imageUrls           Json         @default("[]") @db.JsonB
  suggestedStopLoss   Decimal?     @map("suggested_stop_loss") @db.Decimal(12, 5)
  suggestedTakeProfit Decimal?     @map("suggested_take_profit") @db.Decimal(12, 5)
  status              SignalStatus @default(DRAFT)
  createdBy           String       @map("created_by") @db.Uuid
  publishedAt         DateTime?    @map("published_at")
  scheduledAt         DateTime?    @map("scheduled_at")
  jobId               String?      @map("job_id")
  currentVersion      Int          @default(1) @map("current_version")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  deletedAt           DateTime?    @map("deleted_at")

  creator   User           @relation(fields: [createdBy], references: [id])
  audience  SignalAudience[]
  versions  SignalVersion[]
  reads     SignalRead[]
  favorites SignalFavorite[]
  archives  SignalArchive[]
  trades    Trade[]

  @@index([status])
  @@index([createdBy])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([status, createdAt])
  @@map("signals")
}

model SignalAudience {
  id        String   @id @default(uuid()) @db.Uuid
  signalId  String   @map("signal_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  signal Signal           @relation(fields: [signalId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([signalId])
  @@index([planId])
  @@map("signal_audience")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?    @db.JsonB
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, readAt]) // Composite for unread count
  @@map("notifications")
}

model NotificationDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  notificationId String             @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus     @default(PENDING)
  externalId     String?            @map("external_id")
  errorMessage   String?            @map("error_message")
  sentAt         DateTime?          @map("sent_at")
  lastEventAt    DateTime?          @map("last_event_at") // timestamp Resend du dernier event applique
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@index([externalId])
  @@index([channel, status])
  @@map("notification_deliveries")
}

// ════════════════════════════════════════
//  Email reputation monitoring (bounce/complaint trends)
// ════════════════════════════════════════

model EmailReputationHistory {
  id            String   @id @default(uuid()) @db.Uuid
  date          DateTime @db.Date
  window        String   // "24h" | "7d" | "30d"
  sent          Int
  delivered     Int
  opened        Int
  clicked       Int
  bounced       Int
  complained    Int
  failed        Int
  bounceRate    Float    // bounced / sent * 100
  complaintRate Float    @map("complaint_rate")
  openRate      Float    @map("open_rate")
  clickRate     Float    @map("click_rate")
  alertLevel    String   @default("ok") @map("alert_level") // "ok" | "warn" | "danger"
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([date, window])
  @@index([window, date])
  @@map("email_reputation_history")
}

// ════════════════════════════════════════
//  Email stats aggregation (GDPR retention)
// ════════════════════════════════════════

model EmailStatsMonthly {
  id          String   @id @default(uuid()) @db.Uuid
  year        Int
  month       Int      // 1-12
  totalEvents Int      @default(0) @map("total_events")
  delivered   Int      @default(0)
  opened      Int      @default(0)
  clicked     Int      @default(0)
  bounced     Int      @default(0)
  complained  Int      @default(0)
  failed      Int      @default(0)
  deliveryDelayed Int  @default(0) @map("delivery_delayed")
  suppressed  Int      @default(0)
  openRate    Float    @default(0) @map("open_rate")
  clickRate   Float    @default(0) @map("click_rate")
  bounceRate  Float    @default(0) @map("bounce_rate")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([year, month])
  @@map("email_stats_monthly")
}

// ════════════════════════════════════════
//  Webhook Dead Letter Queue (resilience)
// ════════════════════════════════════════

model WebhookDlq {
  id           String   @id @default(uuid()) @db.Uuid
  source       String   @default("resend") // future-proof: autres providers
  eventType    String   @map("event_type")
  svixId       String?  @map("svix_id")
  externalId   String?  @map("external_id")
  payload      Json     @db.JsonB
  rawBody      String?  @map("raw_body") // payload brut (pour replay)
  attempts     Int      @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  lastError    String?  @map("last_error")
  status       DlqStatus @default(PENDING)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  replayedAt   DateTime? @map("replayed_at")
  abandonedAt  DateTime? @map("abandoned_at")

  @@index([status])
  @@index([source, eventType])
  @@index([createdAt])
  @@index([svixId])
  @@map("webhook_dlq")
}

enum DlqStatus {
  PENDING
  REPLAYED
  ABANDONED
}

// ════════════════════════════════════════
//  Resend webhook events (real-time email tracking)
// ════════════════════════════════════════

model EmailEvent {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String?  @map("delivery_id") @db.Uuid
  externalId String   @map("external_id") // Resend message id (matches NotificationDelivery.externalId)
  svixId     String   @map("svix_id") // Svix event id (deduplication)
  type       String // email.sent | email.delivered | email.opened | email.clicked | email.bounced | email.complained | email.failed | email.delivery_delayed | email.suppressed
  createdAt  DateTime @default(now()) @map("created_at")
  raw        Json?    @db.JsonB
  clickLink  String?  @map("click_link") // URL cliquée (event email.clicked uniquement)

  @@unique([svixId])
  @@index([externalId])
  @@index([deliveryId])
  @@index([type])
  @@map("email_events")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json?    @db.JsonB
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  searchText   String?  @map("search_text")
  hash         String?  @unique
  previousHash String?  @map("previous_hash")
  severity     String   @default("info") @map("severity")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("settings")
}

// ════════════════════════════════════════
//  Security Models (Phase 2a)
// ════════════════════════════════════════

model SecurityPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @unique @map("user_id") @db.Uuid
  maxSessions     Int      @default(5) @map("max_sessions")
  maxDevices      Int      @default(3) @map("max_devices")
  require2fa      Boolean  @default(false) @map("require_2fa")
  enforceEmailOTP Boolean  @default(false) @map("enforce_email_otp")
  deviceTrustDays Int      @default(30) @map("device_trust_days")

  allowedCountries String[] @default([]) @map("allowed_countries")
  blockedCountries String[] @default([]) @map("blocked_countries")
  allowedIps       String[] @default([]) @map("allowed_ips")
  blockedIps       String[] @default([]) @map("blocked_ips")
  blockVpn         Boolean  @default(true) @map("block_vpn")
  blockTor         Boolean  @default(true) @map("block_tor")
  blockProxy       Boolean  @default(true) @map("block_proxy")

  notifyNewDevice   Boolean @default(true) @map("notify_new_device")
  notifyNewLocation Boolean @default(true) @map("notify_new_location")
  notifySuspicious  Boolean @default(true) @map("notify_suspicious")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("security_policies")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_NEW_DEVICE
  LOGIN_NEW_LOCATION
  LOGIN_SUSPICIOUS_IP
  LOGIN_SESSION_LIMIT
  LOGIN_BLOCKED
  LOGOUT
  SESSION_CREATED
  SESSION_REVOKED
  SESSION_EXPIRED
  SESSION_HIJACK_DETECTED
  DEVICE_REGISTERED
  DEVICE_VERIFIED
  DEVICE_TRUSTED
  DEVICE_REVOKED
  DEVICE_BLOCKED
  DEVICE_SUSPICIOUS
  TWOFA_ENABLED
  TWOFA_DISABLED
  TWOFA_FAILED
  TWOFA_BYPASSED
  TWOFA_RECOVERY_USED
  PASSWORD_CHANGED
  PASSWORD_RESET
  PASSWORD_RESET_FAILED
  EMAIL_VERIFIED
  EMAIL_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ACCOUNT_DELETED
  ACCOUNT_LOCKED
  RISK_SCORE_CHANGED
  IMPOSSIBLE_TRAVEL_DETECTED
  RATE_LIMIT_EXCEEDED
  API_KEY_CREATED
  API_KEY_REVOKED
  ADMIN_ACTION
  ROLE_CHANGED
  PERMISSION_CHANGED
  DATA_EXPORT
  DATA_DELETION_REQUEST
  DATA_DELETION_COMPLETED
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  BROKER_VERIFIED
  SUBSCRIPTION_CHANGED
  SECURITY_ALERT
}

enum SecuritySeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  type      SecurityEventType
  severity  SecuritySeverity
  details   Json              @db.JsonB
  ipAddress String?           @map("ip_address")
  userAgent String?           @map("user_agent")
  deviceId  String?           @map("device_id") @db.Uuid
  sessionId String?           @map("session_id") @db.Uuid
  country   String?
  city      String?
  latitude  Float?
  longitude Float?
  riskScore Int               @default(0) @map("risk_score")
  notified  Boolean           @default(false)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@index([userId, type])
  @@index([createdAt])
  @@map("security_events")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String
  success   Boolean
  ipAddress String   @map("ip_address")
  userAgent String?  @map("user_agent")
  deviceId  String?  @map("device_id") @db.Uuid
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  code      String
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("two_factor_backup_codes")
}

