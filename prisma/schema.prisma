generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth Core Models ──

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // NBA custom fields
  phone             String?
  whatsapp          String?           @map("whatsapp")
  roleId            String            @map("role_id") @db.Uuid
  country           String?
  language          String            @default("fr")
  timezone          String            @default("Europe/Paris")
  onboardingStatus  OnboardingStatus  @default(REGISTERED) @map("onboarding_status")
  isActive          Boolean           @default(true) @map("is_active")
  metadata          Json?             @db.JsonB
  deletedAt         DateTime?         @map("deleted_at")

  sessions            Session[]
  accounts            Account[]
  role                Role                  @relation(fields: [roleId], references: [id])
  accessRequests      AccessRequest[]
  kycDocuments        KycDocument[]         @relation("KycDocuments")
  kycReviews          KycDocument[]         @relation("KycReviews")
  accessReviews       AccessRequest[]       @relation("AccessReviews")
  brokerVerifications BrokerVerification[]  @relation("BrokerVerifications")
  brokerReviews       BrokerVerification[]  @relation("BrokerReviews")
  signals             Signal[]
  signalVersions      SignalVersion[]
  signalReads         SignalRead[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  auditLogs           AuditLog[]
  settings            Setting[]
  devices             Device[]
  deviceVerifications DeviceVerification[]
  signalFavorites     SignalFavorite[]
  signalArchives      SignalArchive[]

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  accountId               String    @map("account_id")
  providerId              String    @map("provider_id")
  accessToken             String?   @map("access_token")
  refreshToken            String?   @map("refresh_token")
  accessTokenExpiresAt    DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt   DateTime? @map("refresh_token_expires_at")
  scope                   String?
  idToken                 String?   @map("id_token")
  password                String?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// ── NBA Business Models ──

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  currency     String
  durationDays Int      @map("duration_days")
  features     Json     @default("[]") @db.JsonB
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  accessRequests AccessRequest[]
  audience       SignalAudience[]

  @@map("subscription_plans")
}

model AccessRequest {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  planId        String       @map("plan_id") @db.Uuid
  status        AccessStatus @default(PENDING)
  reviewedBy    String?      @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?    @map("reviewed_at")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  reviewer User?            @relation("AccessReviews", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([userId, planId, status]) // Composite for access check
  @@map("access_requests")
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String?
  fingerprint  String   @map("fingerprint")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  trusted      Boolean  @default(true) @map("trusted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([fingerprint])
  @@map("devices")
}

model DeviceVerification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  deviceFingerprint String    @map("device_fingerprint")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  verificationCode  String    @map("verification_code")
  expiresAt         DateTime  @map("expires_at")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("device_verifications")
}

model KycDocument {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  documentType   DocumentType       @map("document_type")
  status         VerificationStatus @default(PENDING)
  frontFilePath  String             @map("front_file_path")
  backFilePath   String?            @map("back_file_path")
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  reviewNotes    String?            @map("review_notes")
  reviewedAt     DateTime?          @map("reviewed_at")
  submittedAt    DateTime           @default(now()) @map("submitted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user     User  @relation("KycDocuments", fields: [userId], references: [id])
  reviewer User? @relation("KycReviews", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@map("kyc_documents")
}

model BrokerVerification {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  brokerName    String             @map("broker_name")
  accountId     String             @map("account_id")
  videoFilePath String             @map("video_file_path")
  status        VerificationStatus @default(PENDING)
  reviewedBy    String?            @map("reviewed_by") @db.Uuid
  reviewNotes   String?            @map("review_notes")
  reviewedAt    DateTime?          @map("reviewed_at")
  submittedAt   DateTime           @default(now()) @map("submitted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user     User  @relation("BrokerVerifications", fields: [userId], references: [id])
  reviewer User? @relation("BrokerReviews", fields: [reviewedBy], references: [id])

  @@index([status])
  @@map("broker_verifications")
}

model Signal {
  id             String           @id @default(uuid()) @db.Uuid
  content        String
  imageUrl       String?          @map("image_url") // Pour compatibilité ascendante (premier graphique)
  imageUrls      Json             @default("[]") @db.JsonB // Jusqu'à 5 images
  status         SignalStatus     @default(DRAFT)
  createdBy      String           @map("created_by") @db.Uuid
  publishedAt    DateTime?        @map("published_at")
  scheduledAt    DateTime?        @map("scheduled_at") // Date programmée de publication
  jobId          String?          @map("job_id")       // Job ID BullMQ pour la programmation
  currentVersion Int              @default(1) @map("current_version")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  creator  User            @relation(fields: [createdBy], references: [id])
  audience SignalAudience[]
  versions SignalVersion[]
  reads    SignalRead[]
  favorites SignalFavorite[]
  archives  SignalArchive[]

  @@index([status])
  @@index([createdBy])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@index([status, deletedAt]) // Index composite très fréquent pour le filtrage par statut et soft delete
  @@index([status, createdAt]) // Admin list: filter by status + sort by date
  @@map("signals")
}

model SignalAudience {
  id        String   @id @default(uuid()) @db.Uuid
  signalId  String   @map("signal_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  signal Signal           @relation(fields: [signalId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([signalId])
  @@index([planId])
  @@map("signal_audience")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?    @db.JsonB
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user     User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, readAt]) // Composite for unread count
  @@map("notifications")
}

model NotificationDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  notificationId String             @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus     @default(PENDING)
  externalId     String?            @map("external_id")
  errorMessage   String?            @map("error_message")
  sentAt         DateTime?          @map("sent_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json?    @db.JsonB
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("settings")
}

// ── Enums ──

enum DocumentType {
  ID_CARD
  PASSPORT
  DRIVERS_LICENSE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OnboardingStatus {
  REGISTERED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  KYC_PENDING
  KYC_APPROVED
  BROKER_PENDING
  BROKER_APPROVED
  ACTIVE
  SUSPENDED
  PENDING_EMAIL
  PROFILE_INCOMPLETE
  REVIEW_PENDING
}

enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED
}



enum SignalStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model SignalVersion {
  id        String   @id @default(uuid()) @db.Uuid
  signalId  String   @map("signal_id") @db.Uuid
  version   Int
  content   String
  imageUrls Json     @default("[]") @db.JsonB
  updatedBy String   @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  signal  Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  updater User   @relation(fields: [updatedBy], references: [id])

  @@unique([signalId, version])
  @@map("signal_versions")
}

model SignalRead {
  id        String   @id @default(uuid()) @db.Uuid
  signalId  String   @map("signal_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")
  viewCount Int      @default(1) @map("view_count")

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([signalId, userId])
  @@index([signalId])
  @@index([userId])
  @@map("signal_reads")
}

model SignalTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("signal_templates")
}

model SignalFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  signalId  String   @map("signal_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([signalId, userId])
  @@index([signalId])
  @@index([userId])
  @@map("signal_favorites")
}

model SignalArchive {
  id        String   @id @default(uuid()) @db.Uuid
  signalId  String   @map("signal_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([signalId, userId])
  @@index([signalId])
  @@index([userId])
  @@map("signal_archives")
}
