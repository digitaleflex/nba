  @@index([signalId])
  @@index([userId])
  @@map("signal_archives")
}

// ════════════════════════════════════════
//  Trading Journal (PlanCanna-like)
// ════════════════════════════════════════

enum Direction {
  BUY
  SELL
}

enum TradeResult {
  WIN
  LOSS
  BREAKEVEN
}

enum Mood {
  CONFIDENT
  NEUTRAL
  ANXIOUS
  FEARFUL
  GREEDY
  REVENGE
}

enum StreakType {
  WIN_STREAK
  LOSS_STREAK
  DISCIPLINE_STREAK
}

enum TradeStrategy {
  SCALPING
  DAY_TRADING
  SWING
  POSITION
}

enum TradeSetup {
  BREAKOUT
  PULLBACK
  REVERSAL
  RANGE
  TREND
  OTHER
}

model Trade {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  signalId    String?     @map("signal_id") @db.Uuid
  sessionId   String?     @map("session_id") @db.Uuid

  pair        String
  direction   Direction
  result      TradeResult
  entryPrice  Decimal     @map("entry_price") @db.Decimal(12, 5)
  exitPrice   Decimal     @map("exit_price") @db.Decimal(12, 5)
  stopLoss    Decimal?    @map("stop_loss") @db.Decimal(12, 5)
  takeProfit  Decimal?    @map("take_profit") @db.Decimal(12, 5)
  lotSize     Decimal     @map("lot_size") @db.Decimal(10, 2) @default(0.01)
  pnl         Decimal     @db.Decimal(12, 2) @default(0)
  spread      Decimal?    @db.Decimal(12, 2) @default(0)
  commission  Decimal?    @db.Decimal(12, 2) @default(0)
  swap        Decimal?    @db.Decimal(12, 2) @default(0)

  mood        Mood?
  confidence  Int?
  note        String?
  tags        String[]    @default([])

  strategy    TradeStrategy?
  setupType   TradeSetup?

  tradedAt    DateTime    @map("traded_at") @default(now())
  createdAt   DateTime    @map("created_at") @default(now())
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  user    User            @relation(fields: [userId], references: [id])
  signal  Signal?         @relation(fields: [signalId], references: [id])
  session JournalSession? @relation(fields: [sessionId], references: [id])

  @@index([userId, deletedAt, tradedAt])
  @@index([signalId])
  @@index([sessionId])
  @@map("trades")
}

model JournalSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  planId    String?   @map("plan_id") @db.Uuid

  startedAt DateTime  @map("started_at") @default(now())
  endedAt   DateTime? @map("ended_at")
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime  @map("created_at") @default(now())

  user   User              @relation(fields: [userId], references: [id])
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id])
  trades Trade[]

  @@index([userId, isActive])
  @@map("journal_sessions")
}

model DailyReflection {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  date       DateTime  @db.Date

  rating     Int       // 1-10
  mood       Mood?
  tradeCount Int       @map("trade_count") @default(0)
  wins       Int       @default(0)
  losses     Int       @default(0)
  totalPnl   Decimal?  @map("total_pnl") @db.Decimal(12, 2)
  note       String?

  createdAt  DateTime  @map("created_at") @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("daily_reflections")
}

model Streak {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  type       StreakType
  count      Int        @default(0)
  bestCount  Int        @map("best_count") @default(0)
  lastDisciplineDay DateTime? @map("last_discipline_day")
  startedAt  DateTime   @map("started_at") @default(now())
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("streaks")
}
