# Staging Environment
NEXT_PUBLIC_APP_URL=https://staging.neverbrokeagain.com
NODE_ENV=staging

# Database (Neon)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/nba_staging?sslmode=require

# Redis
REDIS_URL=redis://staging-redis:6379

# Better Auth
BETTER_AUTH_SECRET=change-this-in-production
BETTER_AUTH_URL=https://staging.neverbrokeagain.com

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
